# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neohelp
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neohelp

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security / JWT
SECRET_KEY=change-this-in-production-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
